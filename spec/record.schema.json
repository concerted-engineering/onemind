        "body": {
          "type": "object",
          "required": [
            "left_record_id",
            "right_record_id",
            "relation",
            "evidence_ids",
            "detector"
          ],
          "properties": {
            "left_record_id": {
              "type": "string",
              "minLength": 1
            },
            "right_record_id": {
              "type": "string",
              "minLength": 1
            },
            "relation": {
              "enum": [
                "contradicts",
                "scope-overlap",
                "possible-exception"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "detector": {
              "type": "object"
            },
            "rationale": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "record_id",
        "kind",
        "created_at",
        "actor",
        "body"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1-draft"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "application"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "object",
