{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openkedge.io/onemind/spec/0.1-draft/record.schema.json",
  "title": "OneMind v0.1 draft record",
  "description": "Structural-only validation. Cross-reference and authorization validation MUST be performed by the engine.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "record_id",
        "kind",
        "created_at",
        "actor",
        "body"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1-draft"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "evidence"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "human",
                "service",
                "agent"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "body": {
          "type": "object",
          "required": [
            "source_type",
            "source_uri",
            "source_id",
            "observed_at",
            "source_author",
            "excerpt_sha256",
            "source_state"
          ],
          "properties": {
            "source_type": {
              "type": "string",
              "minLength": 1
            },
            "source_uri": {
              "type": "string",
              "minLength": 1
            },
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "source_author": {
              "type": "string",
              "minLength": 1
            },
            "excerpt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_state": {
              "enum": [
                "available",
                "source-unavailable"
              ]
            },
            "redacted_snapshot": {
              "type": "string"
            },
            "redaction": {
              "type": "object"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "record_id",
        "kind",
        "created_at",
        "actor",
        "body"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1-draft"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "practice_candidate"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "human",
                "service",
                "agent"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "body": {
          "type": "object",
          "required": [
            "statement",
            "proposed_scope",
            "evidence_ids",
            "generator"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "proposed_scope": {
              "type": "object",
              "required": [
                "repository"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": true
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "generator": {
              "type": "object",
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "record_id",
        "kind",
        "created_at",
        "actor",
        "body"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1-draft"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "practice_version"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "human",
                "service",
                "agent"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "body": {
          "type": "object",
          "required": [
            "practice_id",
            "version",
            "statement",
            "scope",
            "owner",
            "evidence_ids",
            "previous_version_id",
            "exceptions"
          ],
          "properties": {
            "practice_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "object",
              "required": [
                "repository"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": true
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "previous_version_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "record_id",
        "kind",
        "created_at",
        "actor",
        "body"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1-draft"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "governance_decision"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "human",
                "service",
                "agent"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "body": {
          "type": "object",
          "required": [
            "target_record_id",
            "target_kind",
            "action",
            "target_sha256",
            "effective_at",
            "authority",
            "proof"
          ],
          "properties": {
            "target_record_id": {
              "type": "string",
              "minLength": 1
            },
            "target_kind": {
              "enum": [
                "practice_version",
                "application",
                "conflict"
              ]
            },
            "action": {
              "enum": [
                "approve",
                "suspend",
                "restore",
                "retire",
                "adjudicate"
              ]
            },
            "target_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "effective_at": {
              "type": "string",
              "format": "date-time"
            },
            "authority": {
              "type": "object"
            },
            "proof": {
              "type": "object"
            },
            "rationale": {
              "type": "string"
            },
            "resolution": {
              "type": "object",
              "required": [
                "disposition",
                "explanation"
              ],
              "properties": {
                "disposition": {
                  "enum": [
                    "prefer-left",
                    "prefer-right",
                    "scoped-exception",
                    "maintain-both",
                    "suspend-both"
                  ]
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "adjudicate"
                  }
                },
                "required": [
                  "action"
                ]
              },
              "then": {
                "required": [
                  "resolution"
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "record_id",
        "kind",
